{
  "description": "`emu avd name` prints nothing on either stream and exits 1. The AVD name is unknown (-), never an error and never a name.",
  "evidence": ["H6"],
  "synthetic": false,
  "rules": [
    {
      "match": ["devices", "-l"],
      "respond": {
        "stdout": "List of devices attached\nemulator-5554          device product:sdk_gphone64_arm64 model:sdk_gphone64_arm64 device:emu64a transport_id:1\nemulator-5556          device product:sdk_gtablet_arm64 model:sdk_gtablet_arm64 device:emu64t transport_id:2\n\n"
      }
    },
    {
      "match": [
        "-s",
        "emulator-5554",
        "shell",
        {
          "re": "echo @sdk; .*"
        }
      ],
      "respond": {
        "stdout": "@sdk\n37\n@boot_completed\n1\n@boot_id\n3f1c8a52-0d7e-4c1b-9b1e-5a3f2d6c7e81\n@size\nPhysical size: 1344x2992\n@density\nPhysical density: 480\n"
      }
    },
    {
      "match": [
        "-s",
        "emulator-5556",
        "shell",
        {
          "re": "echo @sdk; .*"
        }
      ],
      "respond": {
        "stdout": "@sdk\n35\n@boot_completed\n1\n@boot_id\n9b0e7d44-51a2-4c3e-8f6d-2c1b0a9e8d77\n@size\nPhysical size: 2560x1600\n@density\nPhysical density: 320\n"
      }
    },
    {
      "match": ["-s", "emulator-5554", "emu", "avd", "name"],
      "respond": {
        "exit": 1
      }
    },
    {
      "match": ["-s", "emulator-5556", "emu", "avd", "name"],
      "respond": {
        "stdout": "Pixel_Tablet\r\nOK\r\n"
      }
    }
  ]
}
