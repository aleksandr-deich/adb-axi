{
  "name": "adb-axi",
  "version": "0.2.0",
  "description": "Truthful, token-efficient adb for agents: devices, app lifecycle, logs and app data",
  "keywords": [
    "adb",
    "android",
    "axi",
    "agent",
    "cli",
    "toon"
  ],
  "license": "MIT",
  "author": "Aleksandr Deich",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aleksandr-deich/adb-axi.git"
  },
  "type": "module",
  "bin": {
    "adb-axi": "dist/bin/adb-axi.js"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=24.12"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "dev": "tsx bin/adb-axi.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run build && vitest run",
    "test:device": "npm run build && vitest run --config vitest.device.config.ts",
    "capture": "tsx test/device/capture.ts",
    "check": "npm run build && npm run typecheck && npm run lint && npm run format:check && vitest run && node --test bench/core.test.js",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@toon-format/toon": "2.3.1",
    "axi-sdk-js": "0.1.12"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.1",
    "eslint": "^10.11.0",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3"
  }
}
